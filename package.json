{
	"name": "nyanpasu-file-list",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"serve": "vite preview",
		"migrate:local": "wrangler d1 migrations apply nyanpasu-file-list --local",
		"migrate:remote": "wrangler d1 migrations apply nyanpasu-file-list --remote",
		"deploy": "pnpm run migrate:remote && pnpm run build && wrangler deploy",
		"preview": "pnpm run build && wrangler preview",
		"cf-typegen": "wrangler types",
		"prepare": "pnpm run migrate:local"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@cloudflare/vite-plugin": "^1.62.5",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-router": "^1.170.41",
		"@tanstack/react-start": "^1.168.60",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"filesize": "^11.0.25",
		"kysely": "^0.29.6",
		"kysely-d1": "^0.4.0",
		"lucide-react": "^0.561.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"vite-tsconfig-paths": "^6.1.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^5.2.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"wrangler": "^4.147.0"
	}
}
